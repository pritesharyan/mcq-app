# Local development defaults
DATABASE_URL="file:./prisma/data.db"
SESSION_SECRET="replace-with-a-long-random-secret"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"

# Optional email delivery for password recovery
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Higher Grade Pay - ITI <no-reply@example.com>"

# Optional persistent paths for Render or another hosted server
# UPLOADS_DIR="/opt/render/project/src/storage/uploads"
# BACKUP_DIR="/opt/render/project/src/storage/backups"

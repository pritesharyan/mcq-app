// Prisma schema. Using SQLite now for zero-setup local development.
// To move to Postgres later: change `provider = "sqlite"` to `provider = "postgresql"`,
// set DATABASE_URL in .env to your Postgres connection string, then run
// `npx prisma migrate dev` again. The rest of the app code does not need to change.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  username       String   @unique
  mobile         String?
  email          String   @unique // mandatory - used for forgot-username/password recovery
  password       String   // NOTE: temporary/reset passwords only, see auth routes. Not the user's original password.
  role           String   @default("user") // "user" | "admin" | "master_admin"
  status         String   @default("active") // "active" | "blocked" (admin-controlled login block, separate from the trial cap below)
  unlimitedAccess Boolean @default(false) // master/admin-granted: lifts the 24h trial cap on new "user" accounts (see auth/trial helper)
  createdAt      DateTime @default(now())

  questions        Question[]           @relation("QuestionCreatedBy")
  suggestions      QuestionSuggestion[]
  examMaterials    ExamMaterial[]
  testAttempts     TestAttempt[]
  sessions         UserSession[]
  practiceAttempts PracticeAttempt[]
}

model Paper {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  books         PaperBook[]
  examMaterials ExamMaterial[]
}

model Book {
  id        Int         @id @default(autoincrement())
  name      String
  papers    PaperBook[]
  questions Question[]
}

model PaperBook {
  paperId Int
  bookId  Int
  paper   Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  book    Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([paperId, bookId])
}

model Question {
  id             Int      @id @default(autoincrement())
  bookId         Int
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  questionText   String   // One language per question
  option1        String
  option2        String
  option3        String
  option4        String
  correctOption  Int
  explanation    String?
  attachmentPath String?
  attachmentType String?  // "image" | "pdf"
  createdById    Int
  createdBy      User     @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  suggestions      QuestionSuggestion[]
  practiceAttempts PracticeAttempt[]
}

model QuestionSuggestion {
  id             Int      @id @default(autoincrement())
  questionId     Int
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  suggestionText String
  status         String   @default("pending") // "pending" | "reviewed" | "resolved"
  adminNote      String?
  createdAt      DateTime @default(now())
}

// A row in the "Exam Material Download" table users can browse (paper/book reference PDFs etc.)
model ExamMaterial {
  id           Int      @id @default(autoincrement())
  paperId      Int?
  paper        Paper?   @relation(fields: [paperId], references: [id])
  materialName String   // book/material name shown in the table
  downloadLink String
  keywords     String?  // free-text hashtags/keywords, e.g. "#algebra #geometry maths" - used for search
  addedById    Int
  addedBy      User     @relation(fields: [addedById], references: [id])
  createdAt    DateTime @default(now())
}

// A completed "Take a Test" run, so a user can see their past results.
// Scoring happens server-side here (not trusted from the client) when the test is submitted.
model TestAttempt {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  totalQuestions  Int
  attempted       Int      // answered, whether right or wrong (excludes skipped/unvisited)
  correctCount    Int
  durationSeconds Int      // how long the test took, from start to submit
  answersJson     String   // JSON: [{questionId, chosenOption, correctOption, isCorrect}], used for the review screen
  createdAt       DateTime @default(now())
}

// One row per login, for the master admin's "User Engagement" view. lastActiveAt is
// updated periodically (a throttled "heartbeat" on authenticated requests, not just at
// login) specifically so "time spent" reflects real activity rather than just how long
// the login cookie happens to remain valid if someone closes the tab without logging out.
model UserSession {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  loginAt      DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  logoutAt     DateTime? // null while the session is ongoing (or was abandoned without explicit logout)
}

// One row per (user, question) ever answered in PRACTICE MCQ mode (not "Take a Test",
// which is tracked separately via TestAttempt). Upserted on every practice answer, so a
// row's mere existence means "this user has practiced this question at least once" -
// which is exactly what both the Practice Log (progress per book) and the 24h trial's
// 50-question cap need to count.
model PracticeAttempt {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  questionId    Int
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  bookId        Int      // denormalized from question.bookId at write time, for fast per-book grouping
  isCorrect     Boolean
  chosenOption  Int?
  createdAt     DateTime @default(now()) // first-practiced time (kept on update, see routes/practice.js)
  lastAttemptAt DateTime @default(now()) // most recent attempt time - powers "Last Practiced" in the Practice Log

  @@unique([userId, questionId])
}
